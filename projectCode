.settings-container h2 {
  margin-bottom: 32px;
  font-size: 32px;
  font-weight: 700;
}

.settings-section {
  margin-bottom: 24px;
  padding: 24px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
